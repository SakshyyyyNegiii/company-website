rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is accessing their own data
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles collection: a user can only read and write their own private document
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Appointments collection: public creation allowed, read/update restricted to owner
    match /appointments/{appointmentId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        (request.auth.token.email != null && resource.data.userEmail == request.auth.token.email)
      );
      allow create: if true;
      allow update, delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        (request.auth.token.email != null && resource.data.userEmail == request.auth.token.email)
      );
    }

    // Direct enterprise inquiries & audit requests
    match /inquiries/{inquiryId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        (request.auth.token.email != null && resource.data.email == request.auth.token.email)
      );
      allow create: if true;
      allow update, delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        (request.auth.token.email != null && resource.data.email == request.auth.token.email)
      );
    }

    // Connection test document
    match /test/connection {
      allow read, write: if true;
    }
  }
}

